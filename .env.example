# ==============================================================================
# FLEET TELECOM - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# AVISO: Nunca comite arquivos .env com senhas reais ou tokens de produção.
# A imagem Docker é construída localmente no servidor: fleet-app:1.0.0
# Em produção Swarm, utilize Docker Secrets para senhas e chaves sensíveis.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação (fleet_app)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
TZ=America/Belem

# URL do frontend público roteado pelo Traefik
APP_URL=https://fleet.nortetelecom.net.br

# ------------------------------------------------------------------------------
# 2. Banco de dados (SQLite, dentro do próprio app)
# Um arquivo só: $DATA_DIR/fleet.db. Em produção monte um volume nessa pasta.
# Backup = copiar o fleet.db (ou: sqlite3 fleet.db ".backup copia.db").
# ------------------------------------------------------------------------------
DATA_DIR=./data
# Primeiro acesso em banco novo: cria este administrador.
# Sem FLEET_ADMIN_PASSWORD, uma senha temporária é gerada e mostrada no log.
FLEET_ADMIN_LOGIN=admin
FLEET_ADMIN_NAME=Administrador
FLEET_ADMIN_PASSWORD=
# Dias que um login fica válido no aparelho
SESSION_DAYS=30

# ------------------------------------------------------------------------------
# 3. Chaves de Inteligência Artificial e Integrações de Apoio
# Em produção, configure o segredo no Swarm: gemini_api_key
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy... (Carregada via Docker Secret: gemini_api_key)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. WhatsApp (WAHA)
# ------------------------------------------------------------------------------
# A URL, a API key e a sessão da WAHA são informadas em Configurações no app.
# Exemplo de servidor: https://waha.nortetelecom.net.br

# Segurança de saída (SSRF): hosts que o servidor pode chamar em nome do navegador.
# Separe por vírgula. Subdomínios são aceitos (ex.: appselsyn.com.br cobre api.appselsyn.com.br).
TRACKING_ALLOWED_HOSTS="appselsyn.com.br"
# Deixe vazio para aceitar qualquer host público, ou fixe o seu servidor WAHA:
WAHA_ALLOWED_HOSTS=""
# Permite chamar endereços internos (localhost, 10.x, 192.168.x). Necessário se a
# WAHA estiver na rede interna (ex.: http://waha:3000); prefira junto com WAHA_ALLOWED_HOSTS.
ALLOW_PRIVATE_OUTBOUND="false"
